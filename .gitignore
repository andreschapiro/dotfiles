raycast*
.claude/*

# Private fonts (licensed, stored in dotfiles-data)
fonts/*.otf
fonts/*.ttf
fonts/monolisa-nerdfont-patch

# Private data repo (cloned into dotfiles)
dotfiles-data/

# SSH keys (never commit private keys)
home/.ssh/id_*
home/.ssh/known_hosts
home/.ssh/*.pub

# Personal and machine-specific configuration (stored in dotfiles-data)
home/.ssh/config
home-server/.ssh/config
home/.gitconfig
home/.config/git/.gitconfig
home/.config/dev/state/
home/.config/dev/projects/*.conf
!home/.config/dev/projects/example.conf
home/.config/nvim/spell/*.add*
home-server/.config/systemd/user/*.service
home/.npmrc

# Secrets and credentials (catch-all)
*.pem
*.key
*.secret
.env
.env.*
credentials.json
secrets.json

# Neovim lazy lockfile
home/.config/nvim/lazy-lock.json
