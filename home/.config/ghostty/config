adjust-underline-position = 8
adjust-underline-thickness = 2
auto-update-channel = "tip"
cursor-invert-fg-bg = true
keybind = "global:super+ctrl+.=toggle_quick_terminal"
macos-icon = "custom-style"
macos-icon-frame = "aluminum"
macos-icon-ghost-color = "86e1fc"
macos-icon-screen-color = "222436"
macos-option-as-alt = "true"
macos-titlebar-style = native
mouse-hide-while-typing = "true"

#font
font-family = "MonoLisa Variable"
font-size = 12
font-thicken = true
font-thicken-strength = 50
bold-is-bright = true

#theme
theme = omarchy


#window
window-width = 90
window-height = 30
window-inherit-working-directory = true
window-padding-color = background
window-padding-balance = true
window-padding-x = 8 
window-padding-y = 4 
working-directory = home
# background-opacity = 0.96
# background-blur-radius = 55

#clipboard
clipboard-trim-trailing-spaces = true
clipboard-read = allow
clipboard-write = allow

# Always show ghostty as the title
title = ghostty

